# Sanity.io Content Lake credentials for the blog integration
# Copy to a local .env file (not committed) and populate with your project values
SANITY_PROJECT_ID=
SANITY_DATASET=production
# ISO date for the API version exposed by your Sanity dataset
SANITY_API_VERSION=2024-01-01
# Optional read token for private datasets (leave empty for public projects)
SANITY_READ_TOKEN=
